# ─────────────────────────────────────────────────────────────────────────────
# GUIxcoder environment variables
# Copy to .env and fill in.  Any OpenAI-compatible endpoint works:
# OpenAI, OpenRouter, ModelScope, local Ollama, vLLM, SGLang, etc.
# ─────────────────────────────────────────────────────────────────────────────

# Code-generation LLM (used by --model).
OPENAILIKE_BASE_URL=https://api.openai.com/v1
OPENAILIKE_API_KEY=sk-your-key-here

# Feedback/summarisation model (--fb_model).  Falls back to the code LLM
# above if left unset.
OPENAILIKE_FB_BASE_URL=
OPENAILIKE_FB_API_KEY=

# VLM for screenshot analysis (--vlm_model).
OPENAILIKE_VLM_BASE_URL=http://localhost:11434/v1
OPENAILIKE_VLM_API_KEY=ollama

# Anthropic VLM (optional; used when --vlm_model contains "claude").
ANTHROPIC_VLM_BASE_URL=https://api.anthropic.com
ANTHROPIC_VLM_API_KEY=
